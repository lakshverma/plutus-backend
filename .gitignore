# Secrets. `.env` alone would leave .env.local, .env.backup and friends tracked.
.env
.env.*
!.env.example
node_modules
.DS_Store
.qodo

# Runtime logs (keep the directory, ignore its contents)
log/*
!log/.gitkeep

# TLS certificates / key material (provide via env, not the repo)
*.crt

# Local working notes (this repo is public — keep internal detail out of it)
CLAUDE.md
