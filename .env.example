# Plutus backend configuration.
#
# Copy to .env and fill in. Every setting has one name in every environment; only the
# values differ, and each environment's values live in one place only — this file for
# local development, the hosting platform's environment for production. Production
# credentials should never appear in a local .env.
#
# NODE_ENV is deliberately absent: `npm run dev` sets it to development, and the
# hosting platform sets it to production. It selects logging and framework behaviour,
# never credentials.

# --- Database ---------------------------------------------------------------
# Two roles against the same database. DATABASE_URL owns the tables and so bypasses
# row-level security (used by the superAdmin pool, migrations and seeds).
# DATABASE_URL_TENANT connects as the `tenant` role, which owns nothing and has
# BYPASSRLS = false, so tenant isolation policies bind. Never point application
# traffic at the owner role.
DATABASE_URL=postgresql://owner:password@localhost:5432/plutus
DATABASE_URL_TENANT=postgresql://tenant:password@localhost:5432/plutus

# TLS for both pools.
#   require    verify against the system CA store (managed providers: Neon, RDS, ...)
#   verify-ca  verify against a private CA (DigitalOcean and similar)
#   disable    no TLS; a local Postgres only
PGSSL_MODE=disable
# Private CA for PGSSL_MODE=verify-ca, as a file path or inline PEM. Prefer the file
# path locally: a certificate cannot be stored inline in a .env, because dotenv
# cannot hold a raw multi-line value and will silently truncate it to its first line.
# PGSSL_CA_FILE=./src/common/util/ca-certificate.crt
# PGSSL_CA=

# Max connections per pool (two pools). Keep well under the provider's cap.
# PG_POOL_MAX=5

# --- HTTP -------------------------------------------------------------------
PORT=3003

# Browser origins allowed to call this API, comma-separated. Defaults to
# CLIENT_BASE_URL when unset. One `*` may stand in for a single hostname label, so a
# preview-deployment pattern can be allowed alongside production:
#   https://plutus.example.com,https://plutus-*.vercel.app
# CORS_ALLOWED_ORIGINS=

# Reverse-proxy hops to trust for X-Forwarded-For. 0 locally; 1 behind a single
# platform load balancer, or per-IP rate limiting collapses into one shared bucket.
TRUST_PROXY_HOPS=0

# Per-IP rate limit ceilings (windows are fixed in config.js).
# RATE_LIMIT_GLOBAL_MAX=100
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_HEAVY_MAX=30

# --- Auth -------------------------------------------------------------------
# JWT signing key. Generate with: openssl rand -hex 32
# Use a different value per environment so a development token cannot be replayed
# against production. Rotating it invalidates outstanding password-reset links.
SECRET=

# Root operator login. Leave both unset to disable root login entirely.
# ROOT_PASSWORD_HASH is a bcrypt hash, not a password. Generate one with:
#   node -e "console.log(require('bcrypt').hashSync(process.argv[1], 10))" 'your-password'
# ROOT_USER=
# ROOT_PASSWORD_HASH=

# --- URLs -------------------------------------------------------------------
# This API's public URL; builds email verification links.
APP_BASE_URL=http://localhost:3003
# The frontend's public URL; builds password reset links.
CLIENT_BASE_URL=http://localhost:3000

# --- Email (Resend) ---------------------------------------------------------
# Use a separate API key per environment so development traffic cannot spend the
# production sending quota or affect the domain's reputation.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=Plutus <onboarding@resend.dev>

# When true, mail is logged instead of sent. Keep it on in development: no mistyped
# recipient can then receive real email, whichever API key is configured.
MAIL_DRY_RUN=true

# --- Logging ----------------------------------------------------------------
# error | warn | info | http | debug
LOG_LEVEL=http
